# =============================================================================
# 环境变量模板
# 用法：复制本文件为 .env，填入真实值。严禁将真实密钥提交到 git。
# 安全要求：.env* 已被 .gitignore 忽略；推送到 GitHub 前请确认 Push Protection 已开启。
# =============================================================================

# ---- 应用基础 ----
# 运行环境：development / staging / production
APP_ENV=
# 服务监听端口
APP_PORT=
# 日志级别：debug / info / warn / error
LOG_LEVEL=

# ---- 数据库（示例）----
# 数据库连接串，格式：driver://user:password@host:port/dbname
DATABASE_URL=

# ---- 外部服务密钥（按需填写，未使用请删除）----
# API 密钥：用于调用外部服务
API_KEY=
# API 密钥（另一个服务）
SECOND_API_KEY=

# ---- 认证 ----
# JWT 签名密钥：至少 32 字节随机值
JWT_SECRET=
# 会话加密密钥
SESSION_SECRET=
# 会话 Cookie 名称
SESSION_COOKIE_NAME=
# 会话 Cookie SameSite：Lax 或 Strict
SESSION_COOKIE_SAMESITE=
# 会话 Cookie Secure：本地 HTTP 联调设为 false
SESSION_COOKIE_SECURE=
# 服务端会话 TTL（秒）
SESSION_TTL_SECONDS=
# OIDC 登录草稿 TTL（秒）
OIDC_LOGIN_DRAFT_TTL_SECONDS=
# 再认证窗口（秒）
REAUTH_WINDOW_SECONDS=
# 审批请求 TTL（秒）
APPROVAL_TTL_SECONDS=
# OIDC IdP issuer URL（本地 mock：http://127.0.0.1:8090）
OIDC_ISSUER=
# OIDC 客户端 ID
OIDC_CLIENT_ID=
# OIDC 客户端密钥
OIDC_CLIENT_SECRET=
# OIDC 回调 URI
OIDC_REDIRECT_URI=
# ID token 中映射 users.idp_subject 的 claim 名
OIDC_CLAIM_SUBJECT=

# ---- 集成中心（连接器 webhook HMAC）----
# GitHub 入站 webhook 验签密钥（env:GITHUB_WEBHOOK_SECRET 引用解析）
GITHUB_WEBHOOK_SECRET=
# Jenkins 入站 webhook 验签密钥（env:JENKINS_WEBHOOK_SECRET 引用解析）
JENKINS_WEBHOOK_SECRET=
# Jenkins API Token（env:JENKINS_API_TOKEN 引用解析；HTTP Basic 密码位）
JENKINS_API_TOKEN=

# ---- TestRun ----
# 心跳超时（秒）；未配置则不启动周期回收（TBD，无产品默认秒数）
TEST_RUN_HEARTBEAT_TIMEOUT_SECONDS=

# ---- 制品本地卷（M0/M1）----
# Playwright 截图/视频/Trace 落盘根目录（键名仅；路径由部署注入）
ARTIFACT_ROOT=

# ---- 外部 CI 报告与日志（S-M2-05）----
# Jenkins 控制台日志单片字节上限
CI_LOG_CHUNK_BYTES=
# Jenkins 控制台日志累计字节上限（超限显式 log_truncated，非静默截断）
CI_LOG_MAX_TOTAL_BYTES=
# 报告解析超时（秒）；留空则不启用超时判定
REPORT_PARSE_TIMEOUT_SECONDS=
# 超大报告分批解析每批行数
REPORT_PARSE_BATCH_ROWS=

# ---- 前端（Vite，envDir 为仓库根）----
# 浏览器 API 基址；留空则使用相对路径 /api/v1
VITE_API_BASE_URL=

# ---- 告警/监控（按需填写）----
# 错误上报 DSN
SENTRY_DSN=