# =============================================================================
# 环境变量模板
# 用法：复制本文件为 .env，填入真实值。严禁将真实密钥提交到 git。
# 安全要求：.env* 已被 .gitignore 忽略；推送到 GitHub 前请确认 Push Protection 已开启。
# =============================================================================

# ---- 应用基础 ----
# 运行环境：development / staging / production
APP_ENV=
# 服务监听端口
APP_PORT=
# 日志级别：debug / info / warn / error
LOG_LEVEL=

# ---- 数据库（示例）----
# 数据库连接串，格式：driver://user:password@host:port/dbname
DATABASE_URL=

# ---- 外部服务密钥（按需填写，未使用请删除）----
# API 密钥：用于调用外部服务
API_KEY=
# API 密钥（另一个服务）
SECOND_API_KEY=

# ---- 认证 ----
# JWT 签名密钥：至少 32 字节随机值
JWT_SECRET=
# 会话加密密钥
SESSION_SECRET=
# 会话 Cookie 名称
SESSION_COOKIE_NAME=
# 会话 Cookie SameSite：Lax 或 Strict
SESSION_COOKIE_SAMESITE=
# 服务端会话 TTL（秒）
SESSION_TTL_SECONDS=
# OIDC 登录草稿 TTL（秒）
OIDC_LOGIN_DRAFT_TTL_SECONDS=
# 再认证窗口（秒）
REAUTH_WINDOW_SECONDS=
# OIDC IdP issuer URL
OIDC_ISSUER=
# OIDC 客户端 ID
OIDC_CLIENT_ID=
# OIDC 客户端密钥
OIDC_CLIENT_SECRET=
# OIDC 回调 URI
OIDC_REDIRECT_URI=
# ID token 中映射 users.idp_subject 的 claim 名
OIDC_CLAIM_SUBJECT=

# ---- 前端（Vite，envDir 为仓库根）----
# 浏览器 API 基址；留空则使用相对路径 /api/v1
VITE_API_BASE_URL=

# ---- 告警/监控（按需填写）----
# 错误上报 DSN
SENTRY_DSN=